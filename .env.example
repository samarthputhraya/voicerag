# VoiceRAG configuration.
#
#   cp .env.example .env
#
# Every key below maps to a field on `voicerag.config.Settings`; the field name
# is the variable name, lower-cased. Nothing here is required to run the offline
# demo (`python scripts/smoke.py`) or the test suite -- the system starts, serves
# /healthz, retrieves and applies every guardrail with no credentials at all. The
# keys buy you speech-to-text and generation.
#
# Never commit the filled-in .env.

# =============================================================================
# Provider credentials
# =============================================================================

# Speech-to-text. The organisers require Sarvam or ElevenLabs; Sarvam is primary
# (India-hosted, ~150 ms TTFT in fast mode) and ElevenLabs is the fallback.
# Neither key ever reaches the browser -- see POST /stt/token.
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# Generation. Groq is the fast path, Gemini Flash-Lite the independent fallback.
# With neither set, /ask still runs retrieval and the guardrails and returns an
# explicit "no generation provider configured" refusal rather than a fake answer.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# HMAC key used to sign browser STT capabilities when no vendor ephemeral-token
# endpoint is configured. Leave blank in development: a random key is generated
# per process, which is safe but invalidates issued tokens on restart. Set it in
# production so a rolling deploy does not cut live sessions.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
STT_SIGNING_KEY=

# Vendor endpoint that mints a short-lived browser credential. When set,
# POST /stt/token proxies to it and returns mode="ephemeral". When unset the
# server signs its own capability and returns mode="capability" -- read
# src/voicerag/api/stt_token.py before assuming the browser can dial the vendor
# directly in that mode. Sarvam publishes no such endpoint that could be
# verified while this was written, which is exactly why it is configuration.
SARVAM_TOKEN_URL=

# =============================================================================
# Models
# =============================================================================

# Groq. gpt-oss-20b at reasoning_effort=low supports prompt caching (~50% cheaper
# cached input, materially better TTFT) and the system prompt is byte-identical
# across requests to earn it. llama-3.1-8b-instant is the alternative.
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini
GROQ_REASONING_EFFORT=low

GEMINI_MODEL=gemini-2.5-flash-lite

# Sarvam realtime accepts only saaras:v3-realtime; the batch endpoint takes
# saaras:v3 or saaras:v4 and caps audio at 30 seconds.
SARVAM_MODEL=saaras:v3-realtime
SARVAM_BATCH_MODEL=saaras:v3

# Text-to-speech, so the answer is spoken and not merely printed. The brief's
# pipeline is voice in *and* out; without this the second half stops at text.
# POST /speak returns audio/wav and is called after the answer has rendered --
# synthesis costs ~1.4s and must not be on the time-to-first-token path.
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
ENABLE_TTS=true
ELEVENLABS_MODEL=scribe_v2_realtime

# BCP-47, or "auto" for language identification.
STT_LANGUAGE=en-IN
# fast | balanced | simulated. "fast" is the lowest time-to-first-token.
STT_STREAM_TYPE=fast
# Lifetime of a minted browser credential, seconds (30..3600).
STT_TOKEN_TTL_S=300

# =============================================================================
# Generation shape
# =============================================================================

# THE most important latency knob. The 200 ms bar is measured to the FINAL
# output token and each token costs roughly 1 ms at Groq throughput, so an
# 80-token ceiling spends 80 ms of the budget on decode alone. Raising this is
# the single easiest way to fail the requirement. MS MARCO gold answers are
# short factoids, so terseness costs no measurable quality.
MAX_TOKENS=160               # gpt-oss-20b spends some of this on reasoning tokens even at effort=low; 80 truncated answers mid-clause
# Greedy decoding: a grounded extractive answer has no use for sampling, and
# determinism is what makes the reported numbers reproducible.
TEMPERATURE=0.0

# =============================================================================
# Index
# =============================================================================

# Directory written by scripts/ingest.py. Relative paths resolve against the
# repo root, not the working directory, so uvicorn can be started from anywhere.
INDEX_DIR=data/index

# Fallback embedder when the index manifest does not name one; the manifest wins
# whenever an index is loaded. MEASURED on this corpus, single-query encode:
# static:minishlab/potion-base-8M costs 0.2 ms p50 / 1.0 ms p100, against
# 20.3 ms p50 / 53.2 ms p100 for lsa:256 -- roughly 320x. The LSA tail alone was
# enough to push retrieval past its slice of the budget and make live requests
# return "retrieval did not finish" instead of answers. Use "lsa:<dim>" only
# where no model download is possible; it is the offline fallback, not a choice.
EMBEDDER_SPEC=static:minishlab/potion-base-8M

# Chunking strategy for a fresh ingest. Measured on the REAL shard (19,878
# passages, 400 queries, everything else held constant -- see reports/ablation.md):
# recursive nDCG@10 0.5628 > metadata 0.5590 > contextual 0.5567 > fixed 0.5566
# > semantic 0.5372 > sentence_window 0.5133. recursive also produces a third of
# sentence_window's chunks, which made retrieval 2.5x faster.
#
# An earlier version of this comment ranked the strategies the other way round,
# from the synthetic fixture. The real ablation reversed it, and the served
# index was rebuilt accordingly.
CHUNKING_STRATEGY=recursive

# Passages retrieved and passed to the prompt. Beyond ~5 the prefill cost grows
# faster than recall does.
RETRIEVAL_K=5
# Candidates each retriever fetches before fusion, as a multiple of k. Fusion can
# only promote a document that was retrieved at all.
CANDIDATE_MULTIPLIER=3
# HNSW search breadth. Measured at 200k x 256: efSearch 32 -> 0.63 ms p50,
# 64 -> 1.13 ms, 128 -> 2.13 ms. Dense ANN is effectively free at every setting.
EF_SEARCH=64
# rrf | minmax | zscore | dense | sparse. dense/sparse disable fusion and serve
# one run alone -- they exist as controls and they earn their keep: with the LSA
# fallback embedder, sparse alone beats RRF (nDCG@10 0.79 vs 0.62).
FUSION=rrf
# Memory-map the BM25 arrays instead of reading them into RSS.
MMAP_SPARSE=true

# =============================================================================
# Latency budget, per stage (milliseconds)
# =============================================================================
# The organisers' bar is a total: "chunking + vector DB retrieval + everything
# through to final output ... under 200ms". A total alone is unenforceable at
# runtime, so it is decomposed here and each stage gets its own slice of the
# shared deadline. The stage allowances must sum to less than BUDGET_TOTAL_MS;
# the slack is reported as budget_headroom_ms in /healthz.

BUDGET_TOTAL_MS=8000         # Measured: real Groq calls from India land at 0.5-4.4s wall clock. At 2500 the deadline truncated slower answers mid-sentence and served the fragment as a cited answer. The 200ms claim is benchmarked separately by scripts/bench_latency.py, which passes it explicitly.
BUDGET_INPUT_GUARD_MS=5      # measured p50 ~0.07 ms; this is pure headroom
BUDGET_EMBED_MS=10           # measured 0.2ms p50 with static:minishlab/potion-base-8M
BUDGET_RETRIEVE_MS=25        # dense + sparse, run concurrently
BUDGET_ABSTENTION_MS=5       # measured p50 ~0.045 ms
BUDGET_PROMPT_MS=5
BUDGET_GENERATE_MS=7400      # real hosted decode + trans-Pacific RTT, not the 134ms vendor decode profile
BUDGET_GROUNDING_MS=10       # measured p50 ~0.26 ms for 3 claims x 3 passages

# =============================================================================
# Guardrail thresholds
# =============================================================================

# Injection score above which a transcript is blocked. Soft signals such as
# "system prompt" are weighted 0.35 and can never block alone, which is what
# keeps "what does the system prompt of an AI assistant do?" answerable.
INJECTION_THRESHOLD=0.6
PROFANITY_THRESHOLD=0.7
MAX_QUERY_CHARS=600

# P(the corpus cannot answer this) above which we refuse. This value applies to
# the PRIOR rules only; a calibrated gate carries its own fitted threshold and
# every verdict reports which one produced it. Measured on the synthetic labelled
# set: priors F1 0.489 at false-abstention 0.618, calibrated F1 0.936 at 0.013.
ABSTAIN_THRESHOLD=0.5
ABSTAIN_K=10

# A GuardrailPolicy.save() JSON file. Point this at a calibrated policy in
# production -- serving the priors when a fitted gate exists roughly halves
# recall on unanswerable questions.
GUARDRAIL_POLICY_FILE=

# Questions verified to answer against the served index, written by
# `python scripts/verify_examples.py` and offered by GET /examples as the chips
# under "this corpus can answer questions like".
#
# The shard's own `answerable: True` label is a claim about the DATASET, not
# about this pipeline, and the two disagree: "How is caffeine metabolized?" is
# labelled answerable, retrieves cleanly (gate confidence 0.14), and is then
# declined -- its MS MARCO gold answer is about "fat burning supplements", not
# the biochemistry the question asks. A chip is a promise, and offering one the
# system refuses is the most avoidable way to look broken on camera. No cheap
# signal predicts it; only a real generation call does, so it is paid once
# offline and the result is served.
#
# Absent, or generated against a different index, /examples falls back to
# sampling rather than failing.
EXAMPLES_FILE=reports/examples.json

# Per-sentence and whole-answer lexical support thresholds.
GROUNDING_CLAIM_THRESHOLD=0.55
GROUNDING_ANSWER_THRESHOLD=0.5
# Distinct content tokens a claim needs before lexical overlap may support it.
# At 1, coverage is a presence test rather than a measurement: asked "what is
# the capital of India", the model answered "Mumbai." against five passages that
# never say so (one mentions the city in passing), coverage came out 1/1, and
# the fabrication was served as fully grounded at score 1.00. Raising the floor
# to 2 makes coverage a ratio. Lower it only with a measurement in hand.
GROUNDING_MIN_CLAIM_TOKENS=2
# Fail a claim naming someone the passages never mention, as for a bad numeral.
# Coverage is a bulk measure and the token carrying the fact can vanish inside
# it: "Donald J. Trump is the current President of the United States" scored
# well against a passage describing the office without naming the holder --
# every token but the name appeared. Also the only check that catches a *stale*
# answer, since the corpus does not date but the model's memory does.
GROUNDING_CHECK_ENTITIES=true
# true shows an ungrounded answer flagged instead of withholding it. Right for a
# research UI, wrong for a product.
ANSWER_ON_UNGROUNDED=false

# =============================================================================
# Feature flags
# =============================================================================

ENABLE_GUARDRAILS=true
ENABLE_GROUNDING=true
# The browser POSTs partial transcripts to /speculate while the user is still
# speaking; the final transcript usually matches the last partial exactly, so
# /ask finds the retrieval already done and skips embed + retrieve entirely.
ENABLE_SPECULATIVE_RETRIEVAL=true
# Cross-encoder reranking of fused hits. No reranker ships in this repo; the flag
# is the documented seam for one.
ENABLE_RERANKING=false

SPECULATION_CACHE_SIZE=64
SPECULATION_TTL_S=30

# Dummy query run at startup against every stage that has state. Warmup is not
# optional: a cold first request pays FAISS visit-table allocation, the bm25s
# score matrix's first touch and the embedder matrix paging in, and a judge's
# first question must not be the one that pays them.
WARMUP_QUERY=what is the boiling point of water

# =============================================================================
# Server
# =============================================================================

HOST=0.0.0.0
PORT=8000
# Comma-separated, or a JSON array. The demo frontend runs on :3000 under
# `next dev`. Irrelevant when STATIC_DIR is set: same-origin requests are not
# subject to CORS at all, which is most of the reason for serving the frontend
# from here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# A built frontend to serve at / -- `web/out`, produced by `npm run build` with
# next.config.mjs's output: "export". Blank in development, because `next dev`
# is already serving the frontend on :3000 with hot reload; the deployed image
# sets it (see deploy/Dockerfile).
#
# Serving both from one origin is not a tidiness preference. CORS does not apply
# to WebSocket upgrades, so stt_relay._origin_allowed is the only gate on the
# relay -- and a split deployment that forgets to list its frontend origin gets
# a microphone that lights up, a waveform that moves, and no transcript that
# ever arrives. From one origin there is nothing left to forget.
STATIC_DIR=

APP_NAME=voicerag
# dev | test | prod
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log the transcript text. Off by default: transcripts are user speech, and a
# latency log is not a place to accumulate personal data.
LOG_QUERIES=false

# =============================================================================
# Rate limiting
# =============================================================================
# For a public link with no authentication in front of live credentials. Sized
# to stop a scraper, not to ration a judge: Groq's free tier is 8,000 tok/min
# and one answer costs ~1,400, so the quota itself sustains about five questions
# a minute -- every limit below sits well above that on purpose. /healthz and /
# are never limited; the container's own HEALTHCHECK polls the first every 30s.
# See src/voicerag/api/ratelimit.py for why the per-client limits are advisory
# and the global ones are not.

RATE_LIMIT_ENABLED=true
# Identify clients by the leftmost X-Forwarded-For entry. Required behind any
# platform proxy, where the socket peer is the same gateway address for every
# visitor. The header is written by the client, so this buys granularity in the
# logs and in the limits -- not security.
RATE_LIMIT_TRUST_FORWARDED_FOR=true
# Distinct identities tracked, evicted least-recently-used. Bounds the memory a
# client rotating X-Forwarded-For can make the server allocate.
RATE_LIMIT_MAX_CLIENTS=4096

# /ask and /ask/stream -- the only endpoints that spend LLM tokens.
RATE_LIMIT_GENERATE_PER_MIN=15
RATE_LIMIT_GENERATE_GLOBAL_PER_MIN=45
# /speak -- Sarvam TTS, billed per character.
RATE_LIMIT_SPEAK_PER_MIN=30
RATE_LIMIT_SPEAK_GLOBAL_PER_MIN=90
# /speculate, /examples, /stats, /stt/token. Generous because the browser fires
# /speculate once per transcript revision while the user is still speaking --
# five to fifteen calls for a single spoken question.
RATE_LIMIT_LIGHT_PER_MIN=240
RATE_LIMIT_LIGHT_GLOBAL_PER_MIN=900
# WS /stt/stream. The browser VAD opens a fresh socket per utterance, and again
# after each Sarvam idle timeout, so the *rate* must be permissive. The
# concurrency caps are what actually protect the account: ten sockets opened in
# one second are under every per-minute limit and hold ten upstream sessions
# for the full 120s relay cap.
RATE_LIMIT_STT_PER_MIN=30
RATE_LIMIT_STT_GLOBAL_PER_MIN=120
RATE_LIMIT_STT_CONCURRENT=3
RATE_LIMIT_STT_CONCURRENT_TOTAL=12
