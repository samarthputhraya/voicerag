# Secrets and per-host settings for the Oracle deployment.
#
# Lives at /opt/voicerag/.env, mode 600, and is never committed. Everything
# else the service needs is baked into the image (see deploy/Dockerfile) so
# that this file stays short enough to fill in correctly at 2am.

# --- required for a working demo ---------------------------------------------

# Speech-to-text. Without it the microphone connects and then reports
# "stt_unconfigured"; typed questions still work.
SARVAM_API_KEY=

# Generation. Without it retrieval and every guardrail still run, and the API
# returns an explicit "no generation provider configured" refusal rather than a
# fabricated answer.
GROQ_API_KEY=

# --- strongly recommended -----------------------------------------------------

# Fallback provider. Groq's free tier is 8,000 tokens/min, about four or five
# RAG answers, after which the demo says "Every generation provider failed".
# This is the single cheapest insurance available on demo day.
OPENAI_API_KEY=

# --- optional -----------------------------------------------------------------

GEMINI_API_KEY=

# Stabilises issued STT capabilities across restarts. Unset is safe: a random
# key is generated per process.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STT_SIGNING_KEY=

# The public hostname Caddy should obtain a certificate for.
#
# Leave blank and deploy.sh uses <public-ip>.sslip.io, which resolves to the IP
# it names — a real hostname, so Let's Encrypt will issue for it, with no domain
# to buy and no DNS to configure.
#
# Set it to a domain you own if you have one; point an A record at this
# instance first, or the certificate request fails.
SITE_ADDRESS=

# Only for a split deployment where the frontend is hosted elsewhere. Leave
# blank: this image serves the frontend itself, from the same origin.
CORS_ORIGINS=
