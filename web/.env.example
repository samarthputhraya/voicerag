# Base URL of the VoiceRAG FastAPI service.
# Local:  http://localhost:8000
# Deploy: your public origin, e.g. https://voicerag-demo.duckdns.org
# (Unused in the shipped deployment: the API serves the static export from the
# same origin, so the default relative base is correct there.)
NEXT_PUBLIC_API_BASE=http://localhost:8000
